# /etc/atm-listener.env  (chmod 600, owner root). NEVER commit a real copy.
ATM_SOURCE=tiktok
TIKTOK_USERNAME=your_tiktok_name
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
ATM_ROOM=
# private key shown ONCE in /control -> Security (needed when the overlay enforces signatures)
ATM_SIGNING_KEY=
# health endpoint on loopback only; 0/empty = disabled
ATM_HEALTH_PORT=8787
# restart the process if the realtime link is down this long (ms)
ATM_LINK_STALL_MS=300000
ATM_LARGE_GIFT_DIAMONDS=1000
ATM_MAX_JOINS_PER_MIN=30
ATM_MAX_COMMENTS_PER_MIN=60
# EULER_API_KEY=   (only if the sign service rate-limits you; check its price first)
