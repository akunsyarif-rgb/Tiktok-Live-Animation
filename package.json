{
  "name": "tiktok-live-animation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "audio:generate": "node scripts/generate-audio.mjs",
    "test": "node --experimental-strip-types --test --test-timeout=60000 tests/*.test.ts",
    "lint": "eslint .",
    "e2e": "node e2e/run.cjs",
    "listener": "npm --prefix listener start",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@supabase/realtime-js": "^2.118.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=22"
  }
}
