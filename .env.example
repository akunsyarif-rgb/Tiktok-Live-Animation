# ---- Web app (Vercel / local). Both are PUBLIC values by design (they are shipped to the browser). ----
# Supabase project URL and the *anon / publishable* key. NEVER use a service_role / sb_secret_ key (the app refuses it).
# Leave both empty to run same-browser only (no cross-device link).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- TikTok listener (listener/, runs on a Node host you control; NOT on Vercel). Keep these private. ----
TIKTOK_USERNAME=            # streamer @username without @
SUPABASE_URL=               # same project URL as above
SUPABASE_ANON_KEY=          # same anon/publishable key
ATM_ROOM=                   # room code copied from /control (16-64 chars)
# optional
EULER_API_KEY=              # only if the sign server rate-limits you; see docs/TIKTOK_LIVE.md
ATM_LARGE_GIFT_DIAMONDS=1000  # gift worth >= this many diamonds => Gift Large (bundle)
ATM_MAX_JOINS_PER_MIN=30      # joins forwarded per minute (protects free-tier quota)
