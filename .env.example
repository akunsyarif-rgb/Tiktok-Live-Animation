# ---- Web app (Vercel / local). PUBLIC values by design (shipped to the browser). ----
# Supabase project URL + the *anon / publishable* key. NEVER the service_role / sb_secret_ key (the app refuses it).
# Leave empty to run same-browser only (no cross-device link).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Listener (listener/, a Node >=22 host you control; NOT Vercel). PRIVATE. ----
ATM_SOURCE=tiktok               # tiktok (unofficial) | replay (rehearsal file, not a real LIVE)
SUPABASE_URL=                   # same project URL
SUPABASE_ANON_KEY=              # same anon/publishable key
ATM_ROOM=                       # room code from /control
ATM_SIGNING_KEY=                # SECRET private key from /control → Security (needed when the overlay is secured)
TIKTOK_USERNAME=                # streamer @username without @
# optional
EULER_API_KEY=                  # only if the sign service rate-limits you (may be paid: check first)
ATM_LARGE_GIFT_DIAMONDS=1000
ATM_MAX_JOINS_PER_MIN=30
ATM_MAX_COMMENTS_PER_MIN=60
ATM_REPLAY_FILE=                # for ATM_SOURCE=replay
